# =============================================================================
# CineMetrics — Environment Configuration Template (.env.example)
# Copy this file to '.env' and fill in your values.
# NEVER commit '.env' to version control!
# =============================================================================

# Application Environment (development / production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# 1. The Movie Database (TMDB) API
# Get your free API key at: https://www.themoviedb.org/signup
# Settings -> API -> Request API Key (Developer)
# -----------------------------------------------------------------------------
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token_optional

# -----------------------------------------------------------------------------
# 2. Google Cloud / YouTube Data API v3
# Get your free API key at: https://console.cloud.google.com/
# Enable 'YouTube Data API v3' -> Credentials -> Create API Key
# -----------------------------------------------------------------------------
YOUTUBE_DATA_API_KEY=your_youtube_api_key_here

# -----------------------------------------------------------------------------
# 3. Kaggle API Credentials (Optional for automated Kaggle CLI downloads)
# Get your credentials at: https://www.kaggle.com/settings -> API -> Create New Token
# It downloads kaggle.json containing: {"username":"...","key":"..."}
# -----------------------------------------------------------------------------
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# -----------------------------------------------------------------------------
# 4. Database Connection (PostgreSQL 15+)
# Default local Docker Compose settings:
# -----------------------------------------------------------------------------
POSTGRES_USER=cinemetrics
POSTGRES_PASSWORD=cinemetrics_secret
POSTGRES_DB=cinemetrics_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://cinemetrics:cinemetrics_secret@localhost:5432/cinemetrics_db

# -----------------------------------------------------------------------------
# 5. Security & Authentication (JWT Secret)
# Generate a random 64-char hex string: python -c "import secrets; print(secrets.token_hex(32))"
# -----------------------------------------------------------------------------
SECRET_KEY=replace_with_a_random_64_char_secret_key_for_jwt_signing
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# -----------------------------------------------------------------------------
# 6. MLflow Tracking (Local Server)
# -----------------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000

