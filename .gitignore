# -----------------------------------------------------------------------------
data/
*.parquet
*.csv
*.tsv
*.tsv.gz
*.json.gz
*.feather
*.arrow
*.h5
*.hdf5
*.db
*.sqlite
*.sqlite3
!data/.gitkeep

