# =============================================================================
# CineMetrics — .gitignore
# Python ML Backend + React TypeScript Frontend
# =============================================================================

# -----------------------------------------------------------------------------
# Environment & Secrets (NEVER commit these)
# -----------------------------------------------------------------------------
.env
.env.local
.env.production
.env.staging
.env.development
*.env
secrets/
*.key
*.pem
credentials.json
kaggle.json
service_account.json
gcloud_key.json
.netrc

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
.conda/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# -----------------------------------------------------------------------------
